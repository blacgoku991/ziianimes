# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=true
API_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:3000
CORS_ORIGINS=["http://localhost:3000"]

# ---------------------------------------------------------------------------
# Secrets
# JWT_SECRET       : signature des jetons d'accès / rafraîchissement
# ENCRYPTION_KEY   : clé applicative de chiffrement au repos (sessions
#                    marketplace, tokens OAuth). 32 octets encodés en
#                    base64 url-safe. Générer avec :
#                    python -c "import os,base64;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# ---------------------------------------------------------------------------
JWT_SECRET=change-me-in-production-please-32-chars-min
ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Base de données
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://ziia:ziia@localhost:5432/ziia
# Utilisée par la suite de tests. Laisser vide => SQLite en mémoire.
TEST_DATABASE_URL=

# ---------------------------------------------------------------------------
# File de tâches
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
# true => les tâches s'exécutent en ligne (tests / dev sans worker)
CELERY_TASK_ALWAYS_EAGER=false

# ---------------------------------------------------------------------------
# Stockage fichiers : local | s3
# ---------------------------------------------------------------------------
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=./var/storage
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------------------
# Pipeline photo
# ---------------------------------------------------------------------------
IMAGE_MAX_UPLOAD_BYTES=26214400
IMAGE_OUTPUT_QUALITY=93
IMAGE_MIN_LONG_EDGE=1600
IMAGE_ALLOW_UPSCALE=true
# auto | rembg | none  (rembg télécharge un modèle U2-Net au premier appel)
SEGMENTATION_BACKEND=auto
# Distance de Hamming pHash minimale entre une variante et sa source
VARIANT_MIN_PHASH_DISTANCE=10

# ---------------------------------------------------------------------------
# Intelligence artificielle
# AI_PROVIDER : auto | anthropic | stub
#   auto  = Claude si ANTHROPIC_API_KEY est renseignée, bouchon déterministe
#           sinon (le produit reste utilisable hors ligne)
#   stub  = bouchon forcé, aucun appel réseau
# ---------------------------------------------------------------------------
AI_PROVIDER=auto
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5
AI_INPUT_PRICE_PER_MTOK=2.8
AI_OUTPUT_PRICE_PER_MTOK=14.0

# ---------------------------------------------------------------------------
# Publication — ce sont les garde-fous qui évitent la restriction de compte
# ---------------------------------------------------------------------------
PUBLISH_MIN_DELAY_SECONDS=45
PUBLISH_MAX_DELAY_SECONDS=180
PUBLISH_DAILY_CAP_PER_ACCOUNT=40
PUBLISH_MAX_ATTEMPTS=3
# true => la publication automatique exige l'acceptation de l'avertissement
# CGU ; sinon tout est rétrogradé en mode brouillon.
AUTOPUBLISH_REQUIRES_NOTICE=true
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT_MS=30000
# À monter en tmpfs : contient la session en clair pendant le job.
BROWSER_PROFILES_ROOT=./var/browser-profiles

# ---------------------------------------------------------------------------
# Stock, relances et synchronisation
# SYNC_INTERVAL_SECONDS est la FENÊTRE DE SURVENTE : deux acheteurs peuvent
# acheter la même pièce sur deux plateformes entre deux passages.
# ---------------------------------------------------------------------------
STALE_LISTING_DAYS=60
RELIST_MIN_INTERVAL_DAYS=7
SYNC_INTERVAL_SECONDS=600
